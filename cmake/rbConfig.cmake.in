@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The rb library only needs Threads if it was built with thread helpers.
set(_rb_needs_threads @RB_ENABLE_THREAD_HELPERS@)
if(_rb_needs_threads)
    find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/rbTargets.cmake")

check_required_components(rb)
